# Copia este archivo a .env y cambia TODOS los valores.
# .env está en .gitignore: nunca lo subas al repositorio.

# ---------- MySQL (docker compose) ----------
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root
MYSQL_DATABASE=gym
MYSQL_USER=gym_app
MYSQL_PASSWORD=cambia-esta-clave-de-app
# Puerto expuesto en el host (dentro del contenedor siempre es 3306)
MYSQL_PORT=3307

# ---------- Backend ----------
PORT=4000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=gym_app
DB_PASSWORD=cambia-esta-clave-de-app
DB_NAME=gym

# Secreto para firmar los JWT. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=2h

# Origen permitido por CORS (el dev server de Vite)
CORS_ORIGIN=http://localhost:3000

# Intentos permitidos en /api/auth por ventana de 15 minutos (anti fuerza bruta)
AUTH_RATE_LIMIT_MAX=20

# ---------- Administrador inicial ----------
# Se da de alta al arrancar el backend, solo si NO existe todavía.
# La contraseña debe cumplir las mismas reglas que cualquier otra:
# 8+ caracteres, una mayúscula, una minúscula y un carácter especial.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Password_123
ADMIN_NOMBRE=Admin
ADMIN_APELLIDO=Rodriguez

# Poner a false para no sembrar en el arranque (por ejemplo, en producción,
# donde interesa lanzarlo a mano con "npm run db:seed")
SEED_ON_START=true
